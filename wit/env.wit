package plugin:injector;


interface env {
    use error.{plugin-error};
    /// Reads a shared environment variable from the host.
    ///
    /// # Arguments
    ///
    /// * `org_name` - Organization name to scope the environment variable
    /// * `var_name` - Name of the environment variable to read
    ///
    /// # Returns
    ///
    /// * `Ok(string)` - The json-string value of the environment variable if found
    /// * `Err(plugin-error)` - Error if the variable doesn't exist or cannot be read
    shared-env-var: func(org-name: string, var-name: string, plugin-specific: bool) -> result<string, plugin-error>;

    /// Reads a personal environment variable from the host.
    ///
    /// # Arguments
    ///
    /// * `var_name` - Name of the environment variable to read
    ///
    /// # Returns
    ///
    /// * `Ok(string)` - The json-string value of the environment variable if found
    /// * `Err(plugin-error)` - Error if the variable doesn't exist or cannot be read
    personal-env-var: func(var-name: string) -> result<string, plugin-error>;

    /// Reads either a personal environment variable from the host at the given plugin's id.
    ///
    /// For example, the users config could be:
    /// ```json
    /// {
    ///     "LLM_CONFIG": {"model_name": "foo"},
    ///     "deployed-plugin-0.1.0": {"LLM_CONFIG": {"model_name": "bar"}}
    /// }
    /// ```
    ///
    /// ```rust
    /// // in deployer-plugin-0.1.0::work function body
    /// let config = plugin_specific_env_var("LLM_CONFIG");
    /// assert_eq!(config.model_name, "bar");
    /// ```
    ///
    /// # Arguments
    ///
    /// * `var_name` - Name of the environment variable to read
    ///
    /// # Returns
    ///
    /// * `Ok(string)` - The json-string value of the environment variable if found
    /// * `Err(plugin-error)` - Error if the variable doesn't exist or cannot be read
    plugin-specific-env-var: func(var-name: string) -> result<string, plugin-error>;

    /// Reads either a personal or shared environment variable from the host. Prioritization is:
    ///  1. Personal Plugin-Specific
    ///  2. Personal Generic
    ///  3. Organizations
    ///     a. oldest to newest plugin-specific until found
    ///     b. oldest to newest generic until found
    ///
    /// # Arguments
    ///
    /// * `var_name` - Name of the environment variable to read
    ///
    /// # Returns
    ///
    /// * `Ok(string)` - The json-string value of the environment variable if found
    /// * `Err(plugin-error)` - Error if the variable doesn't exist or cannot be read
    env-var: func(var-name: string) -> result<string, plugin-error>;
}
